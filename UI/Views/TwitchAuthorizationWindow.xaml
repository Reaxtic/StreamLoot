<Window x:Class="UI.Views.TwitchAuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UI.Helpers"
        Title="{loc:T Auth.Title}" Width="590" Height="340" MinWidth="490" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MainBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"/>
        <TextBlock x:Name="CodeText" Grid.Row="1" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TwitchBrush}" Margin="0,16,0,6"/>
        <TextBlock x:Name="TimeText" Grid.Row="2" Foreground="{DynamicResource TextMutedBrush}"/>
        <WrapPanel Grid.Row="4" VerticalAlignment="Bottom">
            <Button x:Name="OpenButton" Content="{loc:T Auth.Open}" Click="OnOpen" Margin="0,0,8,8" Padding="14,8"/>
            <Button x:Name="CopyButton" Content="{loc:T Auth.Copy}" Click="OnCopy" Margin="0,0,8,8" Padding="14,8"/>
            <Button x:Name="NewButton" Content="{loc:T Auth.NewCode}" Click="OnNewCode" Margin="0,0,8,8" Padding="14,8"/>
            <Button x:Name="CancelButton" Content="{loc:T Auth.Cancel}" Click="OnCancel" Margin="0,0,8,8" Padding="14,8"/>
        </WrapPanel>
    </Grid>
</Window>
